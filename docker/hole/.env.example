# The HOLE Foundation Paperclip stacks (compose.virgin.yml, compose.central.yml).
# Copy to .env (or paste into Portainer stack env). Only the first block is
# required on the host; everything else can live in Infisical at /bootstrap.

# ── Required on the host ──
# Ephemeral, tagged node: Tailscale OAuth client secret (ephemeral by default)
# or an auth key created with "Ephemeral" checked.
TS_AUTHKEY=
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_PROJECT_ID=

# ── Optional host settings ──
# INFISICAL_API_URL=https://app.infisical.com
# INFISICAL_ENVIRONMENT=prod
# INFISICAL_BOOTSTRAP_PATH=/bootstrap
# TS_EXTRA_ARGS=--advertise-tags=tag:paperclip
# PAPERCLIP_TS_HOSTNAME=paperclip
# TAILNET_DOMAIN=wolverine-wyrm.ts.net
# R2_BUCKET=paperclip
# PAPERCLIP_STORAGE_S3_PREFIX=central

# ── Normally stored in Infisical /bootstrap (set here only to override) ──
# BETTER_AUTH_SECRET=                     # openssl rand -hex 32
# PAPERCLIP_SECRETS_MASTER_KEY=           # openssl rand -base64 32  (central: never change it)
# PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=   # openssl rand -hex 32
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# central only:
# DATABASE_URL=postgres://paperclip:<pw>@portainer.wolverine-wyrm.ts.net:5433/paperclip
# PAPERCLIP_STORAGE_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# RUN_LOG_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# AWS_ACCESS_KEY_ID=                      # R2 API token scoped to the bucket
# AWS_SECRET_ACCESS_KEY=
